<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 亮色：跟随系统的"白天"分支（values-night 换成深色父主题，android:isLightTheme 随之变 false，
         CouiFloatingBar 读的就是它，所以胶囊配色也会一起切） -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 开屏页已删除：窗口底色直接用页面底色，activity 起来就是正式界面，不再有过渡层 -->
        <item name="android:windowBackground">@color/settings_bg</item>
        <!-- Android 12+ 系统 SplashScreen：同色底 + 留空图标，避免先闪一张应用图标卡再进页面 -->
        <item name="android:windowSplashScreenBackground">@color/settings_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
